#!/bin/bash
# t2fancurve - smooth linear fan curve for T2 Macs using the macsmc_hwmon driver
#
# Reads the hottest of the CPU (coretemp) and GPU (amdgpu, if present),
# averages it over SMOOTHING seconds so short processor bursts are ignored,
# maps it linearly from LOW_TEMP (fan minimum) to HIGH_TEMP (fan maximum),
# and moves every fanN_target towards that speed by at most RAMP_UP /
# RAMP_DOWN rpm per second. If the temperature cannot be read the fans go
# straight to maximum. On exit the fans are handed back to the SMC.

CONFIG=/etc/t2fancurve.conf

LOW_TEMP=60
HIGH_TEMP=80
INTERVAL=2
SMOOTHING=6
RAMP_UP=200
RAMP_DOWN=100

# shellcheck source=/dev/null
[ -r "$CONFIG" ] && . "$CONFIG"

log() { echo "$*"; }

find_hwmon() {
    local name
    for d in /sys/class/hwmon/hwmon*; do
        read -r name 2>/dev/null < "$d/name" || continue
        [ "$name" = "$1" ] && { echo "$d"; return 0; }
    done
    return 1
}

for v in LOW_TEMP HIGH_TEMP INTERVAL SMOOTHING RAMP_UP RAMP_DOWN; do
    case ${!v} in
        ''|*[!0-9]*) log "$v must be a whole number (got '${!v}')"; exit 1 ;;
    esac
done
if [ "$LOW_TEMP" -ge "$HIGH_TEMP" ]; then
    log "LOW_TEMP ($LOW_TEMP) must be lower than HIGH_TEMP ($HIGH_TEMP)"
    exit 1
fi
[ "$INTERVAL" -ge 1 ] || { log "INTERVAL must be at least 1"; exit 1; }

SMC=$(find_hwmon macsmc_hwmon) || { log "macsmc_hwmon not found - is this a T2 Mac on a kernel with the macsmc drivers?"; exit 1; }
CPU=$(find_hwmon coretemp)     || { log "coretemp not found"; exit 1; }
GPU=$(find_hwmon amdgpu)       || GPU=""

PARAM=/sys/module/macsmc_hwmon/parameters/fan_control
if [ "$(cat "$PARAM" 2>/dev/null)" != "Y" ]; then
    log "Fan control is disabled in the driver."
    log "Add 'options macsmc-hwmon fan_control=1' to /etc/modprobe.d/macsmc-hwmon.conf and reboot."
    exit 1
fi

shopt -s nullglob
TARGETS=("$SMC"/fan*_target)
[ ${#TARGETS[@]} -eq 0 ] && { log "No fan*_target files in $SMC"; exit 1; }

log "SMC: $SMC, CPU: $CPU, GPU: ${GPU:-none}"
log "Curve: minimum at ${LOW_TEMP}°C, maximum at ${HIGH_TEMP}°C, every ${INTERVAL}s, ${#TARGETS[@]} fan(s)"
log "Smoothing: ${SMOOTHING}s temperature average, ramp +${RAMP_UP}/-${RAMP_DOWN} rpm per second (0 = no limit)"

release() {
    for f in "${TARGETS[@]}"; do echo 0 > "$f"; done
    log "Fans handed back to the SMC"
    exit 0
}
trap release TERM INT

up=$((RAMP_UP * INTERVAL))
down=$((RAMP_DOWN * INTERVAL))
avg=""          # averaged temperature, millidegrees
declare -A cur  # speed last written to each fan
last=""

while true; do
    if read -r t 2>/dev/null < "$CPU/temp1_input" && [ "$t" -gt 0 ] 2>/dev/null; then
        if [ -n "$GPU" ] && read -r g 2>/dev/null < "$GPU/temp1_input" && [ "$g" -gt "$t" ] 2>/dev/null; then
            t=$g
        fi
        if [ -z "$avg" ]; then avg=$t
        else avg=$(( avg + (t - avg) * INTERVAL / (SMOOTHING + INTERVAL) ))
        fi
        deg=$((avg / 1000))
        line="${deg}°C ->"
    else
        deg=""; avg=""
        line="temperature unreadable, fans to maximum ->"
    fi

    for tgt in "${TARGETS[@]}"; do
        n=${tgt##*/fan}; n=${n%_target}
        read -r min < "$SMC/fan${n}_min"
        read -r max < "$SMC/fan${n}_max"

        if [ -z "$deg" ]; then
            rpm=$max                       # failsafe: no ramping
        else
            if   [ "$avg" -le $((LOW_TEMP * 1000)) ];  then want=$min
            elif [ "$avg" -ge $((HIGH_TEMP * 1000)) ]; then want=$max
            else want=$(( min + (max - min) * (avg - LOW_TEMP * 1000) / ((HIGH_TEMP - LOW_TEMP) * 1000) ))
            fi

            # Start from the speed the fan is actually turning at, so taking
            # over from the SMC does not cause a jump either.
            if [ -z "${cur[$n]}" ]; then
                read -r now 2>/dev/null < "$SMC/fan${n}_input" || now=$want
                [ "$now" -gt 0 ] 2>/dev/null || now=$want
                cur[$n]=$now
            fi

            rpm=${cur[$n]}
            if   [ "$want" -gt "$rpm" ]; then
                if [ "$up" -eq 0 ] || [ $((want - rpm)) -le "$up" ]; then rpm=$want; else rpm=$((rpm + up)); fi
            elif [ "$want" -lt "$rpm" ]; then
                if [ "$down" -eq 0 ] || [ $((rpm - want)) -le "$down" ]; then rpm=$want; else rpm=$((rpm - down)); fi
            fi
            [ "$rpm" -lt "$min" ] && rpm=$min
            [ "$rpm" -gt "$max" ] && rpm=$max
        fi

        cur[$n]=$rpm
        if ! echo "$rpm" > "$tgt" 2>/dev/null; then
            log "Failed to write $tgt"
        fi
        line="$line fan$n ${rpm}rpm"
    done

    [ "$line" != "$last" ] && log "$line" && last=$line
    sleep "$INTERVAL" & wait $!
done
